{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@meqyas/web", "exec", "next", "dev", "--port", "3100"],
      "env": { "API_INTERNAL_URL": "http://127.0.0.1:8100" },
      "port": 3100
    },
    {
      "name": "qeu-reel",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "marketing/qeu-reel", "--ignore-workspace", "run", "start"],
      "port": 3151
    },
    {
      "name": "qeu-reel-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "marketing/qeu-reel", "--ignore-workspace", "run", "dev"],
      "port": 3150
    }
  ]
}
