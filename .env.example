# ============================================================================
# MEQYAS AI — environment configuration
# Copy to `.env` (repo root) and adjust. Never commit `.env`.
# ============================================================================

# development | test | production
ENVIRONMENT=development

# ---------------------------------------------------------------- Database
# Async driver is added automatically if you write postgresql://
DATABASE_URL=postgresql+asyncpg://meqyas:meqyas@localhost:5432/meqyas
# Used by the test suite (created automatically by docker compose)
TEST_DATABASE_URL=postgresql+asyncpg://meqyas:meqyas@localhost:5432/meqyas_test

# ------------------------------------------------------------------- Redis
# Optional in development (in-memory fallbacks), REQUIRED in production.
REDIS_URL=redis://localhost:6379/0

# -------------------------------------------------------------------- Auth
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value
# Optional comma-separated old secrets accepted during rotation
JWT_PREVIOUS_SECRETS=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Fernet key for PII/secrets at rest (required in production)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---------------------------------------------------------------------- AI
# openai | openai_compatible | ollama | anthropic | none
AI_PROVIDER=openai
# Optional model overrides (fast = cheap tasks, smart = planning/reports)
AI_MODEL_FAST=
AI_MODEL_SMART=

# OpenAI (default models: gpt-4.1-mini / gpt-4.1)
OPENAI_API_KEY=
# For OpenAI-compatible APIs (OpenRouter, Groq, vLLM, LM Studio...) set AI_PROVIDER=openai_compatible
# e.g. https://openrouter.ai/api/v1  — and set AI_MODEL_FAST / AI_MODEL_SMART
OPENAI_BASE_URL=
# json_schema (strict structured outputs) | json_object | none
OPENAI_STRUCTURED_MODE=json_schema

# Anthropic (default models: claude-haiku-5-5 / claude-sonnet-5-5)
ANTHROPIC_API_KEY=

# Local AI with Ollama (privacy mode). With OLLAMA_ENABLED=true, Ollama is used
# when no cloud provider is configured, or for organizations that disallow cloud AI.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_FAST=qwen2.5:7b
OLLAMA_MODEL_SMART=qwen2.5:7b

# Fallback provider (optional): used automatically while the primary is rate-limited,
# down, rejects its key or retires the model. Use another company serving the same
# open-weight models, e.g. OpenRouter with openai/gpt-oss-20b and openai/gpt-oss-120b.
# openai | openai_compatible | anthropic | none
AI_FALLBACK_PROVIDER=none
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL_FAST=
AI_FALLBACK_MODEL_SMART=
AI_FALLBACK_STRUCTURED_MODE=json_schema

AI_REQUEST_TIMEOUT_S=90
AI_CACHE_TTL_S=3600
AI_DAILY_TOKEN_LIMIT_PER_ORG=2000000

# Gifts (trial accounts sent by platform admins): activation-link validity and the
# plan of a gifted workspace (its limits and AI budget come from the plan).
GIFT_LINK_TTL_DAYS=14
GIFT_PLAN=trial
# Subscriptions & accounts (docs/SUBSCRIPTIONS.md)
ACTIVATION_LINK_TTL_DAYS=14
ADMIN_RESET_LINK_TTL_HOURS=24
SUBSCRIPTION_GRACE_DAYS=7
# Optional «تواصل معنا» link on the sign-in page (mailto:… or https://wa.me/…)
NEXT_PUBLIC_CONTACT_URL=

# ----------------------------------------------------------------- Storage
# local | s3 (S3, MinIO, Cloudflare R2 — any S3-compatible endpoint)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=meqyas
S3_REGION=auto

# --------------------------------------------------------------------- Web
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Where the Next.js server proxies /api/* (API container name in docker)
API_INTERNAL_URL=http://localhost:8000

# Edge proxy (docker compose): ":80" for plain HTTP, or a domain for automatic HTTPS
SITE_ADDRESS=:80

# -------------------------------------------------------------------- Misc
RATE_LIMIT_ENABLED=true
# Proxies in front of the API that append the client IP to X-Forwarded-For.
# 0 in development (pnpm dev); docker compose sets 1 (Caddy). Never more than you really have.
TRUSTED_PROXY_HOPS=0
# Seed the DEMO organization/project on first start in development
SEED_DEMO_ON_STARTUP=true
LOG_LEVEL=INFO
# Password-reset e-mails: empty = printed to the API log (development)
SMTP_URL=
EMAIL_FROM=MEQYAS AI <no-reply@meqyas.example>
